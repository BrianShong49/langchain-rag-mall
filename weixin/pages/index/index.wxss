.banner-swiper { height: 320rpx; border-radius: 12rpx; overflow: hidden; margin-bottom: 20rpx; }
.banner-img { width: 100%; height: 100%; }
.section-title { font-size: 32rpx; font-weight: bold; margin: 20rpx 0; }
.product-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.product-item { width: 48%; background: #fff; border-radius: 12rpx; overflow: hidden; margin-bottom: 20rpx; }
.product-img { width: 100%; height: 300rpx; }
.product-info { padding: 16rpx; }
.product-name { font-size: 26rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.product-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.product-price { color: #f56c6c; font-size: 30rpx; font-weight: bold; }
.product-sales { color: #999; font-size: 22rpx; }
