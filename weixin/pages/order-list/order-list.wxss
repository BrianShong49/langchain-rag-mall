.tab-bar { display: flex; background: #fff; border-radius: 12rpx; margin-bottom: 20rpx; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; color: #666; }
.tab-item.active { color: #409eff; font-weight: bold; border-bottom: 4rpx solid #409eff; }
.order-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.order-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.order-no { font-size: 24rpx; color: #999; }
.order-status { color: #409eff; font-size: 26rpx; }
.order-item { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.oi-name { flex: 1; }
.oi-price { color: #666; }
.order-footer { display: flex; justify-content: space-between; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.order-amount { color: #f56c6c; font-weight: bold; }
.order-time { color: #999; font-size: 22rpx; }
.btn-pay { background: #409eff; color: #fff; margin-top: 12rpx; }
