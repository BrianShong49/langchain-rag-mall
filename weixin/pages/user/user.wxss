.user-header { display: flex; align-items: center; background: #409eff; padding: 40rpx 30rpx; border-radius: 12rpx; color: #fff; }
.avatar, .avatar-img { width: 100rpx; height: 100rpx; border-radius: 50%; flex-shrink: 0; }
.avatar { background: rgba(255,255,255,.3); text-align: center; line-height: 100rpx; font-size: 40rpx; font-weight: bold; }
.user-info { margin-left: 24rpx; }
.nickname { display: block; font-size: 34rpx; font-weight: bold; }
.username { display: block; font-size: 24rpx; opacity: .8; margin-top: 8rpx; }
.menu-list { background: #fff; border-radius: 12rpx; margin-top: 20rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx; }
.arrow { color: #ccc; }
