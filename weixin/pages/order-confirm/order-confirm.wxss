.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.address-section {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.address-main {
  flex: 1;
  min-width: 0;
}

.addr-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.default-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #409eff;
  border: 1rpx solid #409eff;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.addr-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.no-address-text {
  display: block;
  font-size: 30rpx;
  color: #333;
}

.no-address-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 16rpx;
}

.form-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
}

.label {
  width: 100rpx;
  flex-shrink: 0;
  color: #666;
  font-size: 28rpx;
}

.form-item input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
}

.placeholder {
  color: #bbb;
}

.order-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-submit {
  background: #409eff;
  color: #fff;
  border-radius: 8rpx;
}
