.edit-page {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.form-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.textarea-item {
  align-items: flex-start;
  padding: 24rpx 0;
}

.switch-item {
  border-bottom: none;
}

.label {
  width: 150rpx;
  flex-shrink: 0;
  color: #333;
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #333;
}

.field-textarea {
  flex: 1;
  min-width: 0;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.btn-save {
  background: #409eff;
  color: #fff;
  border-radius: 8rpx;
  margin-top: 40rpx;
  font-size: 30rpx;
}
