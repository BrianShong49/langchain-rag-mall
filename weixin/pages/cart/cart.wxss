.cart-item { display: flex; align-items: center; background: #fff; padding: 20rpx; margin-bottom: 16rpx; border-radius: 12rpx; }
.cart-check { margin-right: 16rpx; }
.check-icon { display: inline-block; width: 40rpx; height: 40rpx; border: 2rpx solid #ddd; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 24rpx; color: #fff; }
.check-icon.checked { background: #409eff; border-color: #409eff; }
.cart-img { width: 160rpx; height: 160rpx; border-radius: 8rpx; flex-shrink: 0; }
.cart-info { flex: 1; padding: 0 16rpx; }
.cart-name { font-size: 28rpx; display: block; }
.cart-price { color: #f56c6c; font-size: 30rpx; display: block; margin-top: 8rpx; }
.cart-qty { display: flex; align-items: center; margin-top: 12rpx; }
.qty-btn { width: 48rpx; height: 48rpx; border: 1rpx solid #ddd; text-align: center; line-height: 48rpx; border-radius: 4rpx; }
.qty-num { padding: 0 20rpx; font-size: 28rpx; }
.cart-del { color: #999; font-size: 24rpx; }
.cart-footer { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,.05); }
.total-text { color: #f56c6c; font-size: 32rpx; font-weight: bold; }
.btn-settle { background: #409eff; color: #fff; font-size: 28rpx; padding: 16rpx 40rpx; border-radius: 8rpx; margin: 0; }
