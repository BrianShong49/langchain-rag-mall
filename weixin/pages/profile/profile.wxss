.profile-page {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.section-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
}

.avatar-img,
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-placeholder {
  background: #409eff;
  color: #fff;
  text-align: center;
  line-height: 120rpx;
  font-size: 44rpx;
  font-weight: bold;
}

.avatar-action {
  margin-left: 24rpx;
}

.avatar-tip {
  display: block;
  font-size: 28rpx;
  color: #409eff;
}

.avatar-format {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.label {
  width: 150rpx;
  flex-shrink: 0;
  color: #333;
  font-size: 28rpx;
}

.readonly {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #333;
}

.placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.btn-primary {
  background: #409eff;
  color: #fff;
  border-radius: 8rpx;
  margin-top: 30rpx;
  font-size: 30rpx;
}
