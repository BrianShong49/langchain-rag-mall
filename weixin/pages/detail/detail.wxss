.detail-img { width: 100%; height: 600rpx; }
.detail-info { background: #fff; padding: 30rpx; margin-top: 16rpx; border-radius: 12rpx; }
.detail-price { color: #f56c6c; font-size: 44rpx; font-weight: bold; display: block; }
.detail-name { font-size: 32rpx; font-weight: bold; display: block; margin-top: 16rpx; }
.detail-desc { color: #666; font-size: 26rpx; display: block; margin-top: 16rpx; line-height: 1.6; }
.detail-stock { color: #999; font-size: 24rpx; display: block; margin-top: 16rpx; }
.detail-actions { display: flex; position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx; background: #fff; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,.05); }
.btn-cart { flex: 1; background: #e6a23c; color: #fff; margin-right: 16rpx; border-radius: 8rpx; }
.btn-buy { flex: 1; background: #409eff; color: #fff; border-radius: 8rpx; }
