.address-page {
  min-height: 100vh;
  padding: 20rpx 20rpx 140rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #666;
}

.empty-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.address-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.address-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.default-tag {
  margin-left: auto;
  font-size: 22rpx;
  color: #409eff;
  border: 1rpx solid #409eff;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.address-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  font-size: 26rpx;
  color: #409eff;
}

.action-btn.danger {
  color: #f56c6c;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-add {
  background: #409eff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
}
