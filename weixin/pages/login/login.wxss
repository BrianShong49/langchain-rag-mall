.login-page {
  min-height: 100vh;
  padding: 60rpx 32rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.login-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.login-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.login-sub {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.login-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx 30rpx 40rpx;
  box-sizing: border-box;
}

.form-block {
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-block .form-item {
  border-bottom: none;
}

.form-block .field-tip {
  border-bottom: none;
}

.label {
  width: 150rpx;
  flex-shrink: 0;
  color: #333;
  font-size: 28rpx;
  line-height: 1.4;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #333;
}

.placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.field-tip {
  display: block;
  padding: 0 0 16rpx 150rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.btn-login {
  background: #409eff;
  color: #fff;
  border-radius: 8rpx;
  margin-top: 40rpx;
  font-size: 30rpx;
}

.switch-link {
  text-align: center;
  color: #409eff;
  font-size: 26rpx;
  margin-top: 30rpx;
}
