.chat-page { display: flex; flex-direction: column; height: 100vh; }
.chat-list { flex: 1; overflow-y: auto; box-sizing: border-box; }
.chat-item { margin-bottom: 24rpx; padding: 0 24rpx; box-sizing: border-box; }
.chat-item.user { display: flex; flex-direction: column; align-items: flex-end; }
.chat-item.assistant { display: flex; flex-direction: column; align-items: flex-start; }
.chat-bubble { max-width: 70%; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.6; word-break: break-all; box-sizing: border-box; }
.chat-item.user .chat-bubble { background: #409eff; color: #fff; border-bottom-right-radius: 4rpx; }
.chat-item.assistant .chat-bubble { background: #fff; color: #333; border-bottom-left-radius: 4rpx; }
.chat-time { display: block; font-size: 20rpx; color: #999; margin-top: 8rpx; }
.chat-input-bar { display: flex; align-items: center; padding: 16rpx 20rpx; background: #fff; border-top: 1rpx solid #eee; }
.chat-input { flex: 1; background: #f5f5f5; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.btn-send { background: #409eff; color: #fff; font-size: 28rpx; padding: 0 30rpx; height: 72rpx; line-height: 72rpx; margin-left: 16rpx; border-radius: 8rpx; }
