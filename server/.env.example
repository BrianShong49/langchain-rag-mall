# 数据库配置 MySQL8 端口3308
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/db_ai_shop?charset=utf8mb4

# JWT配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# 文件上传目录
UPLOAD_DIR=D:/uploads14

# ── DeepSeek 对话模型 ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
# ── 阿里云 Embedding（保持不变）──
EMBEDDING_API_KEY=your_aliyun_maas_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=2048

# FAISS向量数据库配置（本地持久化目录 server/vector_store，无需额外配置）

# RAG检索配置
RAG_TOP_K=4

# 文本分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 项目名称
PROJECT_NAME=基于LangChain的带AI智能客服的微信小程序商城系统